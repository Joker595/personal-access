# Replace identity.example.com and mount certificate files before using edge profile.
# Logs intentionally omit query strings, cookies and Authorization headers.
log_format identity_safe '$remote_addr $request_method $uri $status';
limit_req_zone $binary_remote_addr zone=identity:10m rate=5r/s;
server {
  listen 80;
  server_name identity.example.com;
  location /.well-known/acme-challenge/ { root /var/www/acme; }
  location / { return 308 https://$host$request_uri; }
}
server {
  listen 443 ssl;
  server_name identity.example.com;
  ssl_certificate /etc/nginx/tls/fullchain.pem;
  ssl_certificate_key /etc/nginx/tls/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  access_log /dev/stdout identity_safe;
  add_header Strict-Transport-Security 'max-age=31536000' always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy same-origin always;
  client_max_body_size 10m;
  location / {
    limit_req zone=identity burst=20 nodelay;
    limit_req_status 429;
    proxy_pass http://casdoor:8000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_hide_header X-Powered-By;
  }
}
